# Database Configuration (PostgreSQL)
DATABASE_URL=""postgresql://postgres:password@localhost:5432/swiftship?schema=public""
DIRECT_URL=""postgresql://postgres:password@localhost:5432/swiftship?schema=public""

# Authentication (NextAuth / Auth.js)
AUTH_SECRET=""generate-with-openssl-rand-base64-32""
NEXTAUTH_URL=""http://localhost:3000""

# Application Url
NEXT_PUBLIC_APP_URL=""http://localhost:3000""
NEXT_PUBLIC_APP_NAME="SourceDeliveryPro"
NODE_ENV="development"

# Payment Gateways (Leave blank to use built-in Development Simulation mode)
PAYSTACK_SECRET_KEY=""
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=""
FLUTTERWAVE_SECRET_KEY=""
NEXT_PUBLIC_FLUTTERWAVE_PUBLIC_KEY=""
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""
PAYSTACK_WEBHOOK_SECRET=""

# Email Services (Zoho Mail SMTP / Resend)
EMAIL_HOST="smtppro.zoho.com"
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_USER="support@sourcedeliverypro.com"
EMAIL_PASS=""
EMAIL_FROM="support@sourcedeliverypro.com"
EMAIL_FROM_NAME="SourceDeliveryPro"
RESEND_API_KEY=""

# SMS Gateway (Twilio / Termii)
TWILIO_ACCOUNT_SID=""""
TWILIO_AUTH_TOKEN=""""
TWILIO_PHONE_NUMBER=""""
TERMII_API_KEY=""""

# Cloud Object Storage (Vercel Blob / Cloudinary / AWS S3)
STORAGE_PROVIDER=""vercel-blob""
BLOB_READ_WRITE_TOKEN=""""
CLOUDINARY_CLOUD_NAME=""""
CLOUDINARY_API_KEY=""""
CLOUDINARY_API_SECRET=""""

# Map Services
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""""
NEXT_PUBLIC_MAPBOX_TOKEN=""""

# Development Flags
NEXT_PUBLIC_ENABLE_PAYMENT_SIMULATION=true
NEXT_PUBLIC_MAINTENANCE_MODE=false